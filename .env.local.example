# Copy this file to .env.local and adjust as needed.

# Base URL the frontend uses to reach the LedgerLens backend (see backend/README.md).
# Defaults to http://localhost:8000 (see API_BASE in app/page.tsx) when unset, which
# matches `uvicorn app.main:app --reload --port 8000`. Override this if you run the
# backend on a different port (e.g. because 8000 is already taken on your machine).
NEXT_PUBLIC_LEDGERLENS_API_URL=http://localhost:8000
